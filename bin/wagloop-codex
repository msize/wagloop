#!/usr/bin/env bash
# Start Codex in this pane as the wagloop author or reviewer:
#
#   wagloop-codex author [<change-id or description> [gates=...] | review [<name>]] [with=claude] [-- codex args]
#   wagloop-codex reviewer [-- codex args]
#
# Registers this pane in the mailbox first (the sandbox cannot reach wagterm, so Codex could not
# do it itself). The author also gets a left/right split with the Claude reviewer started in the
# other pane right away: from inside the sandbox it could not be started later. Then it runs
# Codex in a workspace-write sandbox rooted at the checkout, without network or approval prompts,
# and with the mailbox copied into its tool environment (Codex strips the environment from tool
# subprocesses). Arguments after `--` go to codex unchanged.
# The configurable status line is turned off: it draws a second footer row under the composer,
# and peer-chat, which strips exactly one, then refuses every ring as "no Codex composer visible".
set -euo pipefail

usage() { echo "usage: wagloop-codex author|reviewer [skill args] [-- codex args]" >&2; exit 2; }

role="${1:-}"
case "$role" in author|reviewer) shift ;; *) usage ;; esac
skill_args=()
while [ $# -gt 0 ] && [ "$1" != "--" ]; do skill_args+=("$1"); shift; done
[ $# -gt 0 ] && shift
[ "$role" = reviewer ] && [ ${#skill_args[@]} -gt 0 ] && usage

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(git rev-parse --show-toplevel)"
flow="${WAGFLOW:-$(cd "$here/../.." && pwd)/wagflow}"
hub="$root/.wagloop"

[ -f "$flow/lib/wagmsg.py" ] || { echo "wagloop-codex: wagflow not found at $flow" >&2; exit 2; }

partner=()
if [ "$role" = author ]; then
  partner=(--with claude)
  for arg in "${skill_args[@]}"; do
    case "$arg" in with=claude|with=devin) partner=(--with "${arg#with=}") ;; with=*) echo "wagloop-codex: a Codex author needs a Claude or Devin reviewer (with=claude|devin)" >&2; exit 2 ;; esac
  done
fi

cd "$root"
python "$here/wagloop.py" --as "$role" init --tool codex "${partner[@]}"

if [ "$role" = author ]; then
  prompt="You are the wagloop AUTHOR. Load the wagloop-author skill and run it with the arguments: ${skill_args[*]:-(none)}"
else
  prompt="You are the wagloop REVIEWER. Load the wagloop-reviewer skill, handle any unread mail from the author, then end your turn."
fi

win() { cygpath -m "$1"; }

exec codex \
  --sandbox workspace-write \
  --ask-for-approval never \
  -c sandbox_workspace_write.network_access=false \
  -c 'tui.status_line=[]' \
  -c "shell_environment_policy.set.AI_HUB='$(win "$hub")'" \
  -c "shell_environment_policy.set.AI_BOX='$role'" \
  -c "shell_environment_policy.set.WAGFLOW='$(win "$flow")'" \
  "$@" \
  "$prompt"
